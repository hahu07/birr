{
  "name": "birr",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @birr/db generate",
    "db:migrate": "pnpm --filter @birr/db migrate"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "multer@<2.2.0": "^2.3.0",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.7",
      "lodash@<=4.17.23": "^4.18.1",
      "tmp@<0.2.6": "^0.2.6",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.2",
      "sharp@<0.35.0": "^0.35.4",
      "postcss@<=8.5.17": "^8.5.26",
      "nanoid@<3.3.18": "^3.3.18",
      "fast-uri@<3.1.6": "^3.1.6"
    }
  }
}
