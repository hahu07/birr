// Birr — Milestone 1 schema
// Mirrors milestone-1-data-model.md. This file cannot express everything
// that doc requires — see
// prisma/migrations/20260731201431_governed_actions_constraints/migration.sql
// for the CHECK constraints and RLS policies applied on top of whatever
// `prisma migrate dev` generates from this file. Note this schema has no
// per-field @map, so Prisma-generated columns are camelCase, not
// snake_case — that migration's raw SQL matches those actual names.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  invited
  active
  suspended
}

enum FounderKind {
  institution
  individual
}

enum InstitutionType {
  islamic_bank
  university
  corporate_foundation
  ngo
  family_office
  government
  awqaf_authority
  other
}

enum FounderStatus {
  active
  suspended
}

enum FounderPermissionLevel {
  primary_contact
  viewer
  requester
}

enum MembershipStatus {
  active
  revoked
}

// Kept as an enum on BirrStaff for quick filtering/display, alongside the
// separate Role/Permission/RolePermission tables for detailed permission
// checks. The two should stay in sync by key. Consider collapsing into a
// single FK-based model once the governance workflow engine (Milestone 3)
// is built — flagged as a rough edge in milestone-1-data-model.md.
enum BirrStaffRole {
  mutawalli_officer
  board_of_trustees
  investment_committee
  shariah_board_member
  audit_committee
  compliance_officer
  legal_adviser
  external_auditor
  platform_admin
}

enum StaffStatus {
  active
  suspended
}

enum WaqfType {
  investment
  asset
  project
  hybrid
}

enum WaqfStatus {
  draft
  active
  suspended
  dissolved
}

enum WaqfFundingPlan {
  lump_sum
  installment
}

enum AssetCategory {
  real_estate
  cash
  securities
  movable
  intellectual_property
  other
}

// Disposal is a real lifecycle transition (asset.dispose is a governed
// action), separate from deletedAt below — a disposed asset is not a
// mistaken record, it's history that must stay visible.
enum AssetStatus {
  active
  disposed
}

enum BeneficiaryStatus {
  active
  inactive
}

// A mosque, orphanage, or other organization is just as real a
// beneficiary as a person — name covers either case, no extra
// organization-only field beyond that for now.
enum BeneficiaryKind {
  individual
  organization
}

enum InvestmentInstrumentType {
  sukuk
  equity_fund
  real_estate_fund
  murabaha
  other
}

enum InvestmentStatus {
  active
  liquidated
}

enum DistributionStatus {
  pending
  approved
  // Real-payout lifecycle, added alongside Distribution.payoutProvider/
  // payoutReference/paidAt/payoutError — see DistributionsService's
  // initiateDisbursement()/handlePayoutWebhook() own comments. approved
  // -> disbursing happens automatically right after a checker approves;
  // disbursing -> paid/payout_failed is webhook-confirmed (async, same
  // posture as ContributionStatus's confirmed/failed transition).
  disbursing
  paid
  payout_failed
  rejected
}

enum CaseAssignmentRole {
  mutawalli_officer
  investment_officer
  compliance_reviewer
  shariah_reviewer
  auditor
}

enum AssignmentStatus {
  active
  reassigned
  closed
}

// Matches the seven agents in CLAUDE.md: Rasid (compliance_monitoring),
// Nazim (caseload_triage), Kashif (anomaly_detection), Rashid
// (investment_research), Rafiq (founder_onboarding), Munsif
// (beneficiary_verification), Bashir (business_development).
enum AgentTaskType {
  compliance_monitoring
  caseload_triage
  anomaly_detection
  investment_research
  founder_onboarding
  beneficiary_verification
  business_development
  other
}

enum AgentStatus {
  active
  disabled
}

enum MakerType {
  human
  ai_agent
}

enum GovernedActionStatus {
  proposed
  approved
  rejected
}

enum CoiStatus {
  declared
  reviewed
  cleared
  escalated
}

enum ActorType {
  birr_staff
  founder_user
  system
  ai_agent
}

enum InviteeKind {
  founder_user
  birr_staff
  co_founder
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum FoundationStatus {
  active
  suspended
}

// ---------- Models ----------

model User {
  id                         String     @id @default(uuid())
  email                      String     @unique
  fullName                   String
  authProviderId             String?
  status                     UserStatus @default(invited)
  mfaEnabled                 Boolean    @default(false)
  // Real password auth for the Founder Portal — see
  // apps/backend/src/common/auth/session.ts. passwordHash is nullable to
  // accommodate any future non-password-auth users (e.g. an eventual
  // WorkOS/Auth0 migration per CLAUDE.md), but is always set for
  // sign-ups created through FoundersService.signUp().
  username                   String?    @unique
  passwordHash               String?
  // Self-service sign-up email verification. Set on signUp(), nulled out
  // once verifyEmail() consumes it — a single active token per user is
  // enough for this use case (no separate token table), same inline-token
  // shape Invitation already uses for the analogous invite-acceptance flow.
  verificationToken          String?    @unique
  verificationTokenExpiresAt DateTime?
  // Step 1 of founder onboarding also requires WhatsApp verification
  // alongside email. whatsappNumber is set (unverified) as soon as an
  // OTP is requested; whatsappVerifiedAt stays null until a WhatsAppOtp
  // is successfully consumed. See WhatsAppOtp below for the short-lived,
  // attempt-limited code itself — deliberately not the same inline-token
  // shape as verificationToken, since a human-typed 6-digit code needs a
  // short expiry and brute-force protection that a 32-byte hex link
  // doesn't.
  whatsappNumber             String?
  whatsappVerifiedAt         DateTime?
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt
  deletedAt                  DateTime?

  founderMemberships         FounderMembership[]             @relation("MembershipUser")
  invitedMemberships         FounderMembership[]             @relation("MembershipInvitedBy")
  birrStaff                  BirrStaff?
  makerActions               GovernedAction[]                @relation("GovernedActionMaker")
  checkerActions             GovernedAction[]                @relation("GovernedActionChecker")
  auditLogs                  AuditLog[]
  sentInvitations            Invitation[]                    @relation("InvitationInvitedBy")
  coiDeclarations            ConflictOfInterestDeclaration[] @relation("CoiDeclaredBy")
  coiReviews                 ConflictOfInterestDeclaration[] @relation("CoiReviewedBy")
  whatsappOtps               WhatsAppOtp[]
  signedWaqfDeeds            WaqfDeed[]
  signedFoundationDeeds      FoundationDeed[]
  updatedProviderCredentials ProviderCredential[]
  proposedCauseSuggestions   CauseCategorySuggestion[]       @relation("CauseSuggestionProposedBy")
  reviewedCauseSuggestions   CauseCategorySuggestion[]       @relation("CauseSuggestionReviewedBy")
  proposedBeneficiaryNominations BeneficiaryNomination[]     @relation("BeneficiaryNominationProposedBy")
  reviewedBeneficiaryNominations BeneficiaryNomination[]     @relation("BeneficiaryNominationReviewedBy")
  causeImpactUpdates         CauseImpactUpdate[]
  notifications              Notification[]
  recordedWaqfProceeds       WaqfProceeds[]
  counterpartyShariahApprovals Counterparty[]                 @relation("CounterpartyShariahApprover")
  createdInvestmentPlacements  InvestmentPlacement[]
  sentMessages                 Message[]

  @@map("users")
}

model Founder {
  id               String           @id @default(uuid())
  name             String
  kind             FounderKind
  institutionType  InstitutionType?
  homeJurisdiction String?
  status           FounderStatus    @default(active)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  memberships        FounderMembership[]
  foundationFounders FoundationFounder[]
  invitations        Invitation[]
  auditLogs          AuditLog[]
  signedWaqfDeeds    WaqfDeed[]
  signedFoundationDeeds FoundationDeed[]
  causeSuggestions   CauseCategorySuggestion[]
  beneficiaryNominations BeneficiaryNomination[]

  @@map("founders")
}

// Lightweight, deliberately — no configurable RBAC here. See CLAUDE.md:
// "No per-founder RBAC to build."
model FounderMembership {
  id              String                 @id @default(uuid())
  founderId       String
  founder         Founder                @relation(fields: [founderId], references: [id])
  userId          String
  user            User                   @relation("MembershipUser", fields: [userId], references: [id])
  permissionLevel FounderPermissionLevel
  status          MembershipStatus       @default(active)
  invitedBy       String?
  invitedByUser   User?                  @relation("MembershipInvitedBy", fields: [invitedBy], references: [id])
  createdAt       DateTime               @default(now())
  revokedAt       DateTime?

  @@unique([founderId, userId])
  @@map("founder_memberships")
}

model BirrStaff {
  id        String        @id @default(uuid())
  userId    String        @unique
  user      User          @relation(fields: [userId], references: [id])
  staffRole BirrStaffRole
  status    StaffStatus   @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  caseAssignments WaqfCaseAssignment[]
  coiDeclarations ConflictOfInterestDeclaration[]

  @@map("birr_staff")
}

model Role {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?

  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id                   String  @id @default(uuid())
  key                  String  @unique
  description          String?
  category             String?
  requiresMakerChecker Boolean @default(false)

  rolePermissions RolePermission[]
  governedActions GovernedAction[]

  @@map("permissions")
}

// Role-level maker/checker eligibility. This is necessary but not
// sufficient — see GovernedAction below for the individual-level guarantee.
model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  canMaker     Boolean    @default(false)
  canChecker   Boolean    @default(false)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Waqf {
  id           String     @id @default(uuid())
  // Every Waqf must belong to a Foundation — see
  // foundations/foundations.service.ts for the only place a Waqf's
  // founder relationship is now established, transitively via
  // Foundation -> FoundationFounder -> Founder.
  foundationId String
  foundation   Foundation @relation(fields: [foundationId], references: [id])
  name         String
  type         WaqfType
  purpose      String?
  jurisdiction String
  status       WaqfStatus @default(draft)
  // The declared total endowment target — nullable because every waqf
  // established before this feature has none (no backfill attempted;
  // see CorpusMinimum below for the admin-enforced floor on new
  // declarations). fundingPlan is NOT NULL with a safe default since
  // "lump sum, pay it all now" was the only behavior that existed
  // before installment funding was added.
  corpusAmount   Decimal?
  corpusCurrency String?
  fundingPlan    WaqfFundingPlan @default(lump_sum)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  caseAssignments WaqfCaseAssignment[]
  governedActions GovernedAction[]
  coiDeclarations ConflictOfInterestDeclaration[]
  assets          Asset[]
  beneficiaries   Beneficiary[]
  investments     Investment[]
  distributions   Distribution[]
  waqfCauses      WaqfCause[]
  contributions   Contribution[]
  waqfDeed        WaqfDeed?
  causeSuggestions CauseCategorySuggestion[]
  proceeds        WaqfProceeds[]
  beneficiaryNominations BeneficiaryNomination[]

  @@map("waqfs")
}

// Lightweight organizational container — "a house for the portfolio of
// waqf funds." Establishing one is plain CRUD, not a governed_actions
// action: it carries no fiduciary weight by itself (no assets, no deed).
// The real trustee relationship still attaches at the Waqf level below,
// exactly as it did before this model existed — see
// waqfs/waqfs.service.ts's create() comment.
model Foundation {
  id           String           @id @default(uuid())
  name         String
  purpose      String?
  jurisdiction String?
  // Set via POST /founders/establish (first Foundation, bundled with
  // Founder creation) — a served-file URL, not the file itself. See
  // apps/backend/src/modules/foundations/logo-storage.service.ts.
  logoUrl      String?
  status       FoundationStatus @default(active)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  foundationFounders FoundationFounder[]
  waqfs              Waqf[]
  invitations        Invitation[]
  foundationDeed     FoundationDeed?
  messages           Message[]

  @@map("foundations")
}

// Founder <-> Birr staff communication, scoped per Foundation (not per
// Waqf Fund — a deliberate choice, confirmed with the owner, over the
// per-waqf organization every other section on a Waqf Fund's own page
// uses). Symmetric: unlike Assets/Beneficiaries/etc., both sides can
// send here, not just Birr staff — this isn't a fiduciary decision, it's
// communication, so it doesn't go through governed_actions and isn't
// audit-logged the way a governed entity's writes are.
model Message {
  id           String     @id @default(uuid())
  foundationId String
  foundation   Foundation @relation(fields: [foundationId], references: [id])
  senderType   ActorType
  senderUserId String
  senderUser   User       @relation(fields: [senderUserId], references: [id])
  body         String     @db.Text
  createdAt    DateTime   @default(now())
  deletedAt    DateTime?

  attachments MessageAttachment[]

  @@index([foundationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id])
  // Original filename, for display only — never used to derive the
  // actual disk path (see MessageAttachmentStorageService, same
  // randomUUID()-named-file convention as LogoStorageService).
  fileName  String
  mimeType  String
  sizeBytes Int
  // Served-file URL, same convention as Foundation.logoUrl.
  url       String
  createdAt DateTime @default(now())

  @@map("message_attachments")
}

// The founder's real, structured e-signature appointing Birr as
// Mutawalli (trustee) over this Foundation and every Waqf Fund
// established under it, now or in the future — the final step of
// onboarding. One-to-one with Foundation, not per-Waqf-Fund
// (WaqfDeed below is the superseded per-fund predecessor, kept only
// for any historical rows — never written to again). Deliberately a
// reversal of the original design ("the real trustee relationship
// attaches at the Waqf level" — see Foundation's own comment above and
// WaqfsService.create()'s comment) after that tradeoff was raised
// directly with the project owner and confirmed. Immutable once
// written, same trigger-based enforcement as WaqfDeed — see that
// model's own migration history for why a trigger, not a bare REVOKE,
// is required once an incoming FK exists.
model FoundationDeed {
  id                  String     @id @default(uuid())
  foundationId        String     @unique
  foundation          Foundation @relation(fields: [foundationId], references: [id])
  signedByUserId      String
  signedByUser        User       @relation(fields: [signedByUserId], references: [id])
  signedByFounderId   String
  signedByFounder     Founder    @relation(fields: [signedByFounderId], references: [id])
  typedLegalName      String
  // Traceability only — deedText below (the verbatim rendered text at
  // signing time) is the actual source of truth for what was agreed to,
  // so a later template edit never retroactively alters a signed record.
  deedTemplateVersion String
  deedText            String     @db.Text
  affirmed            Boolean
  ipAddress           String?
  signedAt            DateTime   @default(now())
  createdAt           DateTime   @default(now())

  @@map("foundation_deeds")
}

// Join, not a single founderId column on Foundation — a Foundation can
// be jointly established by more than one Founder, mirroring the same
// reasoning that justified the old WaqfFounder join one level down
// (removed — see the migration that dropped it). Confirmed with the
// project stakeholder rather than assumed.
model FoundationFounder {
  foundationId     String
  foundation       Foundation @relation(fields: [foundationId], references: [id])
  founderId        String
  founder          Founder    @relation(fields: [founderId], references: [id])
  contributionNote String?

  @@id([foundationId, founderId])
  @@map("foundation_founders")
}

// The standard menu of causes Birr's product team maintains — a Founder
// picks from these for their own Waqf Fund (WaqfCause.causeCategoryId
// below), self-service, rather than a Birr staff member inventing one
// per waqf. Soft-delete only (deletedAt = "retired"): once a Founder has
// selected a category, its WaqfCause row already carries its own copy of
// name/description (see that model's comment), so retiring a category
// here never rewrites or breaks history already on a waqf — it only
// removes the option from what a Founder can newly pick.
model CauseCategory {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  // Single emoji glyph, e.g. "🎓" — visual identity in the Founder's
  // picker; no new asset pipeline needed for a handful of catalog rows.
  icon        String?
  // Product team's own curated display order (ascending, ties broken by
  // name) — not creation order or alphabetical, since neither reflects
  // which causes Birr wants shown first.
  sortOrder   Int       @default(0)
  // Staff-curated, not derived from live selection stats — with so few
  // real waqfs established, usage-based "commonly picked for this type"
  // would be noise for a long while. A UX nudge only (the Founder's
  // picker highlights these first): WaqfType and Cause are genuinely
  // orthogonal (type = how value is held, cause = why it's spent), so
  // this never filters or restricts which categories a Founder can pick
  // for their waqf's type — see the founder-facing CausesSection's own
  // comment. Empty array = "no particular type association," shown
  // alongside every type's suggestions equally, not hidden from any.
  typicalWaqfTypes WaqfType[]
  // Arbitrary depth — a category may itself have a parent that has a
  // parent, and so on. The only rule enforced (in CauseCategoriesService,
  // since Prisma/Postgres can't express acyclicity as a schema
  // constraint) is that a category can never become its own ancestor. A
  // category with children is just a non-selectable grouping label in
  // the Founder's picker; one with none behaves exactly as every
  // category did before this existed.
  parentId    String?
  parent      CauseCategory?  @relation("CauseCategoryChildren", fields: [parentId], references: [id])
  children    CauseCategory[] @relation("CauseCategoryChildren")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  waqfCauses WaqfCause[]
  resultingFromSuggestions CauseCategorySuggestion[]

  @@map("cause_categories")
}

// A theme/purpose within one Waqf Fund's deed (e.g. an Education Fund's
// "Teacher Training", "Scholarships") — NOT a separate legal endowment,
// so this is plain CRUD like Asset/Beneficiary/Investment registration,
// not routed through governed_actions. Beneficiary/Distribution
// reference this so money and eligibility are individually trackable
// per cause within a fund, not just per fund.
//
// Two ways one of these gets created: a Founder selects a CauseCategory
// for their own waqf (causeCategoryId set; name/description copied from
// the category at selection time, not looked up live, so a later edit to
// the category's own name/description never retroactively rewrites a
// waqf's existing cause — same reasoning as WaqfDeed.deedText), or Birr
// staff registers a one-off custom cause outside the standard catalog for
// a case it doesn't cover (causeCategoryId left null, same as before this
// model existed).
model WaqfCause {
  id              String         @id @default(uuid())
  waqfId          String
  waqf            Waqf           @relation(fields: [waqfId], references: [id])
  causeCategoryId String?
  causeCategory   CauseCategory? @relation(fields: [causeCategoryId], references: [id])
  name            String
  description     String?
  // How much of the waqf's live amountRaised (confirmed Contributions —
  // see WaqfCausesService.allocate's own comment) the Founder has
  // earmarked to this cause. Always drawn from amountRaised, for every
  // waqf type including Investment — never from WaqfProceeds, which is
  // a separate pool (see proceedsAllocatedAmount below). Null = not yet
  // allocated. Founder self-service, same posture as selecting the
  // cause itself — a deliberate choice over making this a
  // governed_action; see CLAUDE.md's note on this decision.
  // DistributionsService.assertWithinAllocation() sums this together
  // with proceedsAllocatedAmount as the real ceiling, not just a
  // declared figure.
  allocatedAmount Decimal?
  // How much of the waqf's recorded WaqfProceeds total (see
  // WaqfProceedsService.sumForWaqf) Birr staff has earmarked to this
  // cause — a second, additive pool on top of allocatedAmount above,
  // not a replacement. Investment-type waqfs only (every other waqf
  // type has no investment layer and so never has proceeds to
  // allocate — stays null there). Birr-staff decision, not Founder
  // self-service, unlike allocatedAmount: see
  // WaqfCausesService.allocateProceeds's own comment for why.
  proceedsAllocatedAmount Decimal?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  beneficiaries Beneficiary[]
  distributions Distribution[]
  impactUpdates CauseImpactUpdate[]
  beneficiaryNominations BeneficiaryNomination[]

  @@unique([waqfId, name])
  @@map("waqf_causes")
}

// A periodic, staff-entered record of what a specific waqf's cause has
// actually achieved — CLAUDE.md lists impact measurement as a real waqf
// lifecycle stage; nothing captured it before this. Scoped to the
// per-waqf WaqfCause instance, not the global CauseCategory, since
// impact is fund-specific ("this fund's Education cause helped 340
// students," not "Education in general"). Append-only, no update/delete
// route — a correction is a new entry, not an edit, same posture as
// AuditLog/WaqfDeed: an honest history of what was reported when, not a
// single mutable "current" figure.
model CauseImpactUpdate {
  id               String   @id @default(uuid())
  waqfCauseId      String
  waqfCause        WaqfCause @relation(fields: [waqfCauseId], references: [id])
  reportedByUserId String
  reportedByUser   User     @relation(fields: [reportedByUserId], references: [id])
  periodLabel      String
  narrative        String   @db.Text
  // An optional single headline number ("340" / "students") — free text
  // for the unit rather than a fixed enum, since impact metrics vary
  // wildly by cause (students, liters of water, families housed...).
  metricValue      Int?
  metricLabel      String?
  createdAt        DateTime @default(now())

  @@map("cause_impact_updates")
}

enum CauseSuggestionStatus {
  pending
  approved
  rejected
}

// A Founder's request to add something new to the standard catalog —
// today only Birr staff can (see CauseCategoriesController's
// platform_admin gate); this is the self-service half of that gap.
// Modeled structurally on ConflictOfInterestDeclaration (status +
// reviewedByUserId/reviewedAt), not governed_actions — same "plain CRUD,
// not a fiduciary act on a specific waqf's assets" reasoning already
// established for WaqfCause itself. waqfId is context only (which fund
// prompted the request), not a scope restriction — an approved
// suggestion joins the global catalog, available to every Founder.
model CauseCategorySuggestion {
  id                  String                @id @default(uuid())
  proposedByFounderId String
  proposedByFounder   Founder               @relation(fields: [proposedByFounderId], references: [id])
  proposedByUserId    String
  proposedByUser      User                  @relation("CauseSuggestionProposedBy", fields: [proposedByUserId], references: [id])
  waqfId              String?
  waqf                Waqf?                 @relation(fields: [waqfId], references: [id])
  name                String
  description         String?
  status              CauseSuggestionStatus @default(pending)
  reviewedByUserId    String?
  reviewedByUser      User?                 @relation("CauseSuggestionReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  // Set on approval — the catalog entry this suggestion became. Staff
  // sets icon/sortOrder/typicalWaqfTypes at approval time (the Founder's
  // suggestion supplies only name/description), so this is a genuinely
  // new CauseCategory, not a stub the suggestion pre-creates.
  resultingCategoryId String?
  resultingCategory   CauseCategory?        @relation(fields: [resultingCategoryId], references: [id])
  createdAt           DateTime              @default(now())

  @@map("cause_category_suggestions")
}

enum BeneficiaryNominationStatus {
  pending
  approved
  rejected
}

// A Founder's proposal to register a beneficiary — today only Birr
// staff can (see BeneficiariesController, no @Public() route). Modeled
// structurally on CauseCategorySuggestion above (same propose-then-
// staff-decides shape), not self-service like WaqfCause.allocate: a
// Founder registering their own beneficiaries directly would remove
// Birr's independent eligibility check as trustee and risk self-dealing
// (naming friends/family) — see BeneficiariesService.summaryForFounder's
// own comment on why beneficiary identity is kept confidential from the
// donor by standard endowment practice. Unlike CauseCategorySuggestion,
// waqfId here IS a real scope (a nomination is for one specific waqf's
// beneficiary list, not a shared global catalog).
model BeneficiaryNomination {
  id                  String                       @id @default(uuid())
  waqfId              String
  waqf                Waqf                         @relation(fields: [waqfId], references: [id])
  proposedByFounderId String
  proposedByFounder   Founder                      @relation(fields: [proposedByFounderId], references: [id])
  proposedByUserId    String
  proposedByUser      User      @relation("BeneficiaryNominationProposedBy", fields: [proposedByUserId], references: [id])
  // Nullable in the DB, required at the input-validation layer — same
  // convention as Beneficiary.causeId itself (see that field's own
  // comment).
  causeId             String?
  cause               WaqfCause?                   @relation(fields: [causeId], references: [id])
  name                String
  kind                BeneficiaryKind              @default(individual)
  eligibilityCriteria String
  phone               String?
  email               String?
  // Encrypted JSON, same shape/reasoning as Beneficiary.bankDetailsEncrypted
  // — a Founder-submitted nomination carries this straight through to
  // the resulting Beneficiary on approval, still never decrypted for
  // display back to the Founder.
  bankDetailsEncrypted String?
  // Same reasoning as Beneficiary.payoutProvider — carried through to
  // the resulting Beneficiary on approval, same as bank details.
  payoutProvider       PayoutProvider?
  status              BeneficiaryNominationStatus  @default(pending)
  reviewedByUserId    String?
  reviewedByUser      User?     @relation("BeneficiaryNominationReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt          DateTime?
  reviewNotes         String?
  // Set on approval — the real Beneficiary this nomination became.
  // eligibilityExpiresAt is deliberately NOT carried from a nomination
  // — it's a staff-only decision set after approval, not something a
  // Founder proposes (closer to a governance call than contact info).
  resultingBeneficiaryId String?      @unique
  resultingBeneficiary   Beneficiary? @relation(fields: [resultingBeneficiaryId], references: [id])
  createdAt              DateTime     @default(now())

  @@map("beneficiary_nominations")
}

// The caseload concept — who serves which function on a given waqf.
model WaqfCaseAssignment {
  id             String             @id @default(uuid())
  waqfId         String
  waqf           Waqf               @relation(fields: [waqfId], references: [id])
  birrStaffId    String
  birrStaff      BirrStaff          @relation(fields: [birrStaffId], references: [id])
  assignmentRole CaseAssignmentRole
  status         AssignmentStatus   @default(active)
  assignedAt     DateTime           @default(now())
  closedAt       DateTime?

  @@unique([waqfId, birrStaffId, assignmentRole])
  @@map("waqf_case_assignments")
}

// Registry of agentic AI proposers — Rasid, Nazim, Kashif, Rashid, Rafiq,
// Munsif, Bashir. Every agent-initiated action must trace back to a
// specific row here, never an undifferentiated "the AI."
model AiAgent {
  id        String        @id @default(uuid())
  name      String        @unique
  taskType  AgentTaskType
  status    AgentStatus   @default(active)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  // How an agent authenticates to the backend — mirrors User.passwordHash.
  // Nullable: a registry row can exist (e.g. for future agents) before a
  // key is ever issued. See common/auth/ai-agent-auth.ts.
  apiKeyHash String?

  governedActions GovernedAction[]
  auditLogs       AuditLog[]

  @@map("ai_agents")
}

// THE enforcement point for the individual-level maker/checker rule.
// Prisma cannot express these as schema constraints — they're added as raw
// SQL in the governed_actions_constraints migration:
//   - checkerUserId <> makerUserId, when both are set
//   - exactly one of makerUserId / makerAgentId set, matching makerType
// There is deliberately no checkerAgentId field or relation anywhere in
// this schema. An AI agent can never be the checker. Do not add one.
model GovernedAction {
  id            String               @id @default(uuid())
  // Nullable: a waqf.create action has no waqf yet to reference — that's
  // the whole point of the action. Every other governed action (asset
  // disposal, distribution approval, etc.) is expected to set this.
  waqfId        String?
  waqf          Waqf?                @relation(fields: [waqfId], references: [id])
  permissionId  String
  permission    Permission           @relation(fields: [permissionId], references: [id])
  makerType     MakerType
  makerUserId   String?
  makerUser     User?                @relation("GovernedActionMaker", fields: [makerUserId], references: [id])
  makerAgentId  String?
  makerAgent    AiAgent?             @relation(fields: [makerAgentId], references: [id])
  checkerUserId String?
  checkerUser   User?                @relation("GovernedActionChecker", fields: [checkerUserId], references: [id])
  status        GovernedActionStatus @default(proposed)
  payload       Json
  createdAt     DateTime             @default(now())
  decidedAt     DateTime?

  @@map("governed_actions")
}

// Registration (this model, created directly) and disposal (only via an
// approved asset.dispose governed_action — see WaqfsService.create's
// comment for why WaqfsController has no public create route; the same
// reasoning does NOT apply to registration here, since asset registration
// is not in CLAUDE.md's governed-action list, only disposal is) are
// deliberately different trust levels for the same entity.
model Asset {
  id             String        @id @default(uuid())
  waqfId         String
  waqf           Waqf          @relation(fields: [waqfId], references: [id])
  name           String
  category       AssetCategory
  estimatedValue Decimal
  status         AssetStatus   @default(active)
  disposedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  contribution Contribution?

  @@map("assets")
}

enum ContributionProvider {
  stripe
  paystack
  stablecoin
}

// A Beneficiary's chosen outbound-payout rail — deliberately a separate
// enum from ContributionProvider even though the values mirror it, since
// which rails actually support real payout differs from which support
// real inbound payment. Today only "paystack" has a real, working
// adapter (their Transfers API — bank code + account number); "stripe"
// and "stablecoin" are honest stubs (see distributions/providers' own
// comments on why — Stripe payout needs Connect onboarding, the
// integrated stablecoin gateway is receive-only) that reject cleanly
// rather than pretending to succeed.
enum PayoutProvider {
  stripe
  paystack
  stablecoin
}

enum ContributionStatus {
  pending
  confirmed
  failed
}

// A donor's declared-and-paid contribution toward a Waqf Fund — real
// payment processing (Stripe/Paystack/a stablecoin gateway), not a
// staff-reconciled pledge. Confirming one (via webhook) registers the
// fund's first real Asset (category: cash) and flips the Waqf from
// draft to active — the only place that transition happens today.
model Contribution {
  id                String               @id @default(uuid())
  waqfId            String
  waqf              Waqf                 @relation(fields: [waqfId], references: [id])
  amount            Decimal
  // "USD"/"NGN" for the fiat rails, "USDC"/"USDT" for the stablecoin rail.
  currency          String
  provider          ContributionProvider
  // Stripe Checkout Session id / Paystack transaction reference / crypto
  // gateway charge id — how handleWebhook() finds the matching row.
  // Always equal to this row's own `id` in practice (each adapter is
  // handed the Contribution's id as its correlation reference and
  // echoes it back verbatim in the webhook payload — see the adapters'
  // own comments) — kept as an explicit, uniquely-indexed field rather
  // than implicitly relying on `id` so a future adapter that genuinely
  // needs a provider-assigned reference doesn't require a schema change.
  providerReference String               @unique
  status            ContributionStatus   @default(pending)
  // Set once confirmed and registered as the fund's first real Asset.
  assetId           String?              @unique
  asset             Asset?               @relation(fields: [assetId], references: [id])
  confirmedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("contributions")
}

// Per-currency floor enforced in ContributionsService.initiate() before a
// payment is ever created — a real table (not a hardcoded constant) since
// this is expected to need updating by finance/ops without a code change.
model ContributionMinimum {
  id        String   @id @default(uuid())
  currency  String   @unique
  minAmount Decimal
  updatedAt DateTime @updatedAt

  @@map("contribution_minimums")
}

// The minimum TOTAL corpus a founder may declare when establishing a
// Waqf Fund, per currency — checked once at declaration time
// (WaqfsService.create), not per payment. Deliberately a separate table
// from ContributionMinimum above rather than a second column on it: the
// two answer different questions ("how big must the endowment target
// be" vs "how small can any single payment be") and are managed
// independently by ops/finance.
model CorpusMinimum {
  id        String   @id @default(uuid())
  currency  String   @unique
  minAmount Decimal
  updatedAt DateTime @updatedAt

  @@map("corpus_minimums")
}

// Singleton — always exactly one row (seeded once, never created again).
// installmentMinimumPercent is the admin-configurable floor an
// installment-plan waqf's first payment must clear (see
// ContributionsService.initiate()) — e.g. 25 means at least 25% of the
// declared corpus must be paid before the fund activates.
model WaqfFundingSettings {
  id                        String   @id @default(uuid())
  installmentMinimumPercent Decimal  @default(25)
  updatedAt                 DateTime @updatedAt

  @@map("waqf_funding_settings")
}

// A human-typed 6-digit code needs different properties than either
// existing single-use-token pattern in this schema: a short expiry (not
// User.verificationToken's 24h) and brute-force protection (neither
// verificationToken nor Invitation.token attempt-limits, since neither is
// guessable by hand the way a 1-in-1,000,000 numeric code is). Its own
// table, not inline User columns, so multiple requests/attempts-history
// don't overwrite each other.
model WhatsAppOtp {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  phoneNumber String
  // sha256(code + userId) — the plaintext code is never persisted,
  // same reasoning as never storing a plaintext password.
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@map("whatsapp_otps")
}

// Registration (this model, created directly) is plain CRUD; eligibility
// criteria changes are always a beneficiary.criteria_update governed
// action (see BeneficiariesService.updateCriteria's comment) — same
// two-trust-level split as Asset above.
model Beneficiary {
  id                  String            @id @default(uuid())
  waqfId              String
  waqf                Waqf              @relation(fields: [waqfId], references: [id])
  // Nullable in the DB (no backfill for pre-existing rows, same
  // convention as Investment.counterpartyId) — required going forward
  // at the input-validation layer instead (see
  // BeneficiariesService.CreateBeneficiaryInput and
  // BeneficiaryNominationsService.ProposeBeneficiaryNominationInput,
  // both of which drop @IsOptional() on this).
  causeId             String?
  cause               WaqfCause?        @relation(fields: [causeId], references: [id])
  name                String
  kind                BeneficiaryKind   @default(individual)
  eligibilityCriteria String
  status              BeneficiaryStatus @default(active)
  phone               String?
  email               String?
  // Encrypted JSON {bankName, accountNumber, accountName, bankCode?} —
  // see common/settings/encryption.service.ts's EncryptionService
  // (reused as-is, not a second encryption utility). bankCode is
  // required going forward once payoutProvider is "paystack" and this
  // beneficiary's distribution is actually approved — enforced at
  // DistributionsService.assertPayoutReady()/BeneficiariesService
  // .getDecryptedBankDetailsForPayout(), not here (this stays
  // deliberately optional at the input-DTO level — see BankDetailsInput's
  // own comment on why). Never returned in plaintext to a Founder
  // session, never included in this row's own audit_logs snapshot —
  // decrypted only for a Birr staff-facing read.
  bankDetailsEncrypted String?
  // Which outbound-payout rail this beneficiary is paid through — see
  // PayoutProvider's own comment on why only "paystack" actually pays
  // out today. Nullable, no backfill.
  payoutProvider       PayoutProvider?
  // Lazily checked, not a scheduled job — see
  // DistributionsService.assertBeneficiaryEligible.
  eligibilityExpiresAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  distributions Distribution[]
  // Set when this row was created via BeneficiaryNominationsService
  // .approve() rather than BeneficiariesController.create() directly —
  // null for every staff-registered beneficiary.
  nomination    BeneficiaryNomination?

  @@map("beneficiaries")
}

// Registration (this model, created directly) is plain CRUD; allocation
// changes are always an investment.change governed action (see
// InvestmentsService.changeAllocation's comment) — same two-trust-level
// split as Asset/Beneficiary above.
model Investment {
  id              String                   @id @default(uuid())
  waqfId          String
  waqf            Waqf                     @relation(fields: [waqfId], references: [id])
  name            String
  instrumentType  InvestmentInstrumentType
  allocatedAmount Decimal
  status          InvestmentStatus         @default(active)
  liquidatedAt    DateTime?
  // Nullable — no backfill for any pre-existing rows, same convention as
  // every other nullable addition in this schema. Required going forward
  // by InvestmentsService.create() at the app layer (see that method's
  // own comment): who actually holds this money, tracked once so
  // exposure can be measured across every waqf, not per-fund.
  counterpartyId  String?
  counterparty    Counterparty?            @relation(fields: [counterpartyId], references: [id])
  // Nullable — no backfill, same convention as counterpartyId above. Set
  // only when this row was created as one leg of a bulk
  // InvestmentPlacement (many waqfs, one counterparty placement); a
  // standalone single-waqf POST /investments leaves this null, same as
  // every row created before this feature existed.
  placementId     String?
  placement       InvestmentPlacement?     @relation(fields: [placementId], references: [id])
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  proceeds WaqfProceeds[]

  @@map("investments")
}

// One real-world placement of money with a counterparty, spread across
// however many Waqf Funds contributed to it — the shared anchor that
// lets an officer bulk-create the N per-waqf Investment rows a single
// placement produces in one action, and later record one incoming
// return that gets pro-rated back across every contributing waqf's own
// WaqfProceeds, instead of manually calculating each fund's share by
// hand. No totalAmount/currency stored here — always derived by summing
// this placement's own `investments` (same aggregate-not-denormalize
// posture as CounterpartiesService.exposure()), since each Investment
// row already carries its own allocatedAmount and implicitly its own
// waqf's corpusCurrency (Investment itself has no currency field — see
// InvestmentPlacementsService.create()'s own comment on why every
// contributing waqf must share one corpus currency).
model InvestmentPlacement {
  id              String                   @id @default(uuid())
  name            String
  instrumentType  InvestmentInstrumentType
  counterpartyId  String
  counterparty    Counterparty             @relation(fields: [counterpartyId], references: [id])
  createdByUserId String
  createdByUser   User                     @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime                 @default(now())

  investments Investment[]

  @@map("investment_placements")
}

enum CounterpartyType {
  bank
  asset_manager
  broker_dealer
  fund_administrator
  // A general corporate counterparty that isn't itself a regulated
  // financial institution — e.g. a real estate developer or trading
  // company a waqf invests with directly (murabaha, real estate fund
  // structures). Distinct from "other" so it's queryable/reportable on
  // its own, not lumped into a catch-all.
  business
  other
}

enum CounterpartyStatus {
  pending_review // registered, not yet vetted — can't receive investment
  active // both gates passed — can receive new investment
  under_review // flagged for re-vetting (e.g. license nearing expiry) — new investment blocked, existing untouched
  suspended // Risk & Compliance emergency stop — new investment blocked, existing untouched
  blacklisted // permanent — new investment blocked, existing flagged for wind-down
}

// An external institution actually holding waqf investment money — banks,
// asset managers, broker-dealers. Distinct from Investment.allocatedAmount
// (how much corpus sits in *an instrument*): this is WHO holds it, tracked
// once so exposure can be measured across every waqf, not per-fund.
// Two independent gates must both pass before `status` can become
// `active`: (1) shariahApprovedAt/By, set directly by a shariah_board_member
// (their own domain sign-off, not maker-checker — same posture as a single
// expert declaration, see ConflictOfInterestDeclaration); (2) the
// counterparty.onboard governed_action itself (investment_committee
// proposes, checked by mutawalli_officer/board_of_trustees/audit_committee/
// shariah_board_member) — its onApprove handler (CounterpartiesService.onboard)
// refuses to flip status to active unless gate (1) already passed.
// Reactivating a suspended/blacklisted counterparty goes through the same
// onboard flow again; moving TO suspended/blacklisted is immediate,
// unilateral compliance_officer action (speed over dual-control when
// stopping a bad actor — see CounterpartiesService.suspend's own comment).
model Counterparty {
  id                         String              @id @default(uuid())
  name                       String              @unique
  institutionType            CounterpartyType
  jurisdiction               String
  status                     CounterpartyStatus  @default(pending_review)
  // Basic corporate identity — distinct from regulatoryLicenseNumber
  // below, which is specifically a financial-services license and
  // doesn't apply to a plain "business" counterparty with no such
  // license at all.
  registrationNumber         String?
  address                    String?
  businessActivities         String?
  website                    String?
  contactName                String?
  contactEmail               String?
  contactPhone               String?
  regulatoryLicenseNumber    String?
  regulatingAuthority        String?
  licenseExpiresAt           DateTime?
  shariahApprovedAt          DateTime?
  shariahApprovedByUserId    String?
  shariahApprovedByUser      User?               @relation("CounterpartyShariahApprover", fields: [shariahApprovedByUserId], references: [id])
  // Risk & Compliance's ceiling on total exposure to this ONE counterparty
  // across every waqf combined — null means no limit configured yet.
  // Enforced in InvestmentsService.create() the same way
  // WaqfCause.allocatedAmount is enforced in DistributionsService: a real
  // ceiling, not a decorative figure.
  concentrationLimit         Decimal?
  concentrationLimitCurrency String?
  notes                      String?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  deletedAt                  DateTime?

  investments          Investment[]
  investmentPlacements InvestmentPlacement[]

  @@map("counterparties")
}

// A recorded return/proceeds event for an Investment-type waqf — Birr
// staff enters these periodically (e.g. quarterly) as investments
// generate income. Distinct from Investment.allocatedAmount (how much
// corpus sits in an instrument): this is the *return* that instrument
// produced, which is what actually becomes distributable — the corpus
// itself stays invested, preserving the endowment per classical waqf
// principle. investmentId is optional (a waqf-level return not tied to
// one specific instrument is still valid). Append-only by convention, no
// update/delete route — same posture as CauseImpactUpdate: a correction
// is a new (possibly negative) entry, never an edit, so the income
// history stays honest.
model WaqfProceeds {
  id               String      @id @default(uuid())
  waqfId           String
  waqf             Waqf        @relation(fields: [waqfId], references: [id])
  investmentId     String?
  investment       Investment? @relation(fields: [investmentId], references: [id])
  amount           Decimal
  currency         String
  description      String
  recordedByUserId String
  recordedByUser   User        @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime    @default(now())

  @@map("waqf_proceeds")
}

// Registration (this model, created directly) is a plain draft — CLAUDE.md's
// Munsif "drafts distribution recommendations." Approving it is always a
// distribution.approve governed action (see DistributionsService.approve's
// comment). Unlike Asset/Beneficiary/Investment, a distribution is a
// payout *to* someone, so it references both the Waqf and the Beneficiary.
model Distribution {
  id            String             @id @default(uuid())
  waqfId        String
  waqf          Waqf               @relation(fields: [waqfId], references: [id])
  // Every payout must be traceable to a specific cause (the concrete
  // "individually trackable" requirement), not just to the fund.
  causeId       String
  cause         WaqfCause          @relation(fields: [causeId], references: [id])
  beneficiaryId String
  beneficiary   Beneficiary        @relation(fields: [beneficiaryId], references: [id])
  amount        Decimal
  // No currency existed anywhere on this model before — every monetary
  // field in this schema (Asset.estimatedValue, Investment.allocatedAmount,
  // this one) was a bare Decimal, and a waqf can receive contributions in
  // several currencies (see ContributionMinimum), so summing amount
  // across a waqf's distributions was previously meaningless. Fixed here
  // only, since this is the one entity the cause-level financial rollup
  // needs to sum; see the migration for the backfill on pre-existing rows.
  currency      String
  status        DistributionStatus @default(pending)
  approvedAt    DateTime?
  // Set together, at DistributionsService.initiateDisbursement() time —
  // the real payout rail this distribution was actually sent through
  // (only ever "paystack" today — see PayoutProvider's own comment) and
  // the correlation id its webhook is matched back against. Always this
  // row's own id — same "always the row's own id, echoed back by the
  // provider" convention as Contribution.providerReference.
  payoutProvider  PayoutProvider?
  payoutReference String?          @unique
  // Set once a transfer.success webhook confirms the payout actually
  // landed — see handlePayoutWebhook.
  paidAt          DateTime?
  // Last disbursement failure's message, if any — cleared on a
  // successful retryDisbursement(). Surfaced to staff so a payout_failed
  // row is actionable, not just a dead end.
  payoutError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  @@map("distributions")
}

// reviewedByUserId != declaredByUserId is enforced by a DB CHECK
// constraint (coi_reviewer_not_declarant — see the migration named for
// it), the same pattern as checker_not_maker on GovernedAction.
// declaredByUserId is denormalized from birrStaff.userId at creation time
// specifically so that CHECK can compare two columns on the same row —
// it can't join through BirrStaff to get there.
model ConflictOfInterestDeclaration {
  id               String    @id @default(uuid())
  birrStaffId      String
  birrStaff        BirrStaff @relation(fields: [birrStaffId], references: [id])
  declaredByUserId String
  declaredByUser   User      @relation("CoiDeclaredBy", fields: [declaredByUserId], references: [id])
  waqfId           String?
  waqf             Waqf?     @relation(fields: [waqfId], references: [id])
  declarationText  String
  status           CoiStatus @default(declared)
  declaredAt       DateTime  @default(now())
  reviewedByUserId String?
  reviewedByUser   User?     @relation("CoiReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?

  @@map("conflict_of_interest_declarations")
}

// The founder's real, structured e-signature appointing Birr as
// Mutawalli (trustee) over one specific Waqf Fund — the final step of
// onboarding. One-to-one with Waqf (scoped per-fund, not per-founder,
// matching CLAUDE.md's framing that the trustee relationship attaches
// at establishment of *each* waqf). Immutable like AuditLog once
// written — see the migration for this model, which revokes UPDATE/
// DELETE the same way audit_logs already does.
model WaqfDeed {
  id                  String   @id @default(uuid())
  waqfId              String   @unique
  waqf                Waqf     @relation(fields: [waqfId], references: [id])
  signedByUserId      String
  signedByUser        User     @relation(fields: [signedByUserId], references: [id])
  // Denormalized, same rationale as ConflictOfInterestDeclaration's own
  // declaredByUserId: lets onboarding-status queries read the founder id
  // directly without a join through FounderMembership.
  signedByFounderId   String
  signedByFounder     Founder  @relation(fields: [signedByFounderId], references: [id])
  typedLegalName      String
  // Traceability only — deedText below (the verbatim rendered text at
  // signing time) is the actual source of truth for what was agreed to,
  // so a later template edit never retroactively alters a signed record.
  deedTemplateVersion String
  deedText            String   @db.Text
  affirmed            Boolean
  ipAddress           String?
  signedAt            DateTime @default(now())
  createdAt           DateTime @default(now())

  @@map("waqf_deeds")
}

// Immutable, insert-only. A migration must revoke UPDATE/DELETE on this
// table at the DB role level for the application's runtime connection —
// do not rely on the application layer alone. See the raw-SQL migration.
model AuditLog {
  id             String    @id @default(uuid())
  waqfId         String?
  actorUserId    String?
  actorUser      User?     @relation(fields: [actorUserId], references: [id])
  actorAgentId   String?
  actorAgent     AiAgent?  @relation(fields: [actorAgentId], references: [id])
  // Founders aren't User rows (no FounderMembership built yet — a
  // founder-portal session maps directly to a Founder record), so a
  // founder-initiated action (self-service Foundation/Waqf Fund
  // creation) needs its own actor FK, matching the actorUserId/
  // actorAgentId pattern rather than leaving actorType: founder_user
  // entries with no way to say *which* founder.
  actorFounderId String?
  actorFounder   Founder?  @relation(fields: [actorFounderId], references: [id])
  actorType      ActorType
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@map("audit_logs")
}

// "Who needs to know," not "what happened" — a deliberately separate
// model from AuditLog rather than folded into it. AuditLog is
// insert-only at the DB role level (UPDATE/DELETE revoked, CLAUDE.md's
// non-negotiable) because it's the compliance record; a notification
// needs a mutable readAt, and most of them aren't compliance-relevant
// at all (a "your fund is now active" nudge has no audit-trail reason
// to exist). recipientUserId is always a real User row — both
// birr_staff and founder_user notifications resolve through it, same
// shared-account-table pattern already established everywhere else
// (WhatsAppOtp, FounderMembership, BirrStaff all key off User, not off
// Founder/BirrStaff directly).
model Notification {
  id                String    @id @default(uuid())
  recipientType     ActorType
  recipientUserId   String
  recipientUser     User      @relation(fields: [recipientUserId], references: [id])
  // A stable machine key ("governed_action.proposed"), not free text —
  // this is what NotificationsService's CHANNEL_PLAN and the WhatsApp/
  // email template registries key off of.
  type              String
  title             String
  body              String
  linkUrl           String?
  relatedEntityType String?
  relatedEntityId   String?
  readAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([recipientUserId, readAt])
  @@map("notifications")
}

// One table, discriminated by inviteeKind, for both founder-side and
// Birr-staff-side invitations — same shape (email, token, expiry).
model Invitation {
  id            String           @id @default(uuid())
  inviteeKind   InviteeKind
  email         String
  founderId     String?
  founder       Founder?         @relation(fields: [founderId], references: [id])
  // co_founder only — the EXISTING Foundation this invitation, once
  // accepted, attaches a brand-new Founder to. Null for founder_user/
  // birr_staff invitations, which use founderId instead (an EXISTING
  // Founder a teammate joins) — the two columns are deliberately
  // separate rather than one reused for both meanings.
  foundationId  String?
  foundation    Foundation?      @relation(fields: [foundationId], references: [id])
  roleKey       String?
  invitedBy     String
  invitedByUser User             @relation("InvitationInvitedBy", fields: [invitedBy], references: [id])
  token         String           @unique
  status        InvitationStatus @default(pending)
  expiresAt     DateTime
  createdAt     DateTime         @default(now())

  @@map("invitations")
}

// Third-party provider credentials (Stripe/Paystack/stablecoin gateway/
// Resend/Twilio), configurable through the Ops Console's Platform
// Settings page instead of raw .env edits. encryptedValue is AES-256-GCM
// ciphertext ("<ivB64>.<authTagB64>.<ciphertextB64>") — see
// apps/backend/src/common/settings/encryption.service.ts. A missing row
// for a given (provider, key) means "fall back to the env var" — see
// SettingsService.get() — so this table only ever holds overrides, not
// every credential unconditionally.
model ProviderCredential {
  id              String   @id @default(uuid())
  provider        String
  key             String
  encryptedValue  String   @db.Text
  updatedAt       DateTime @updatedAt
  updatedByUserId String?
  updatedByUser   User?    @relation(fields: [updatedByUserId], references: [id])

  @@unique([provider, key])
  @@map("provider_credentials")
}

enum TrusteeLicenseStatus {
  active
  pending
  suspended
  expired
}

// CLAUDE.md's "Regulatory & assurance posture" section, made concrete:
// acting as trustee is itself a regulated activity in most
// jurisdictions, separate from and beyond security certification — this
// is Birr's own record of where it actually holds that license today,
// keyed by the same free-form jurisdiction string as Waqf.jurisdiction
// (not the Founder's home jurisdiction — see that field's own comment).
// Deliberately not a hard gate on Waqf creation (WaqfsService still
// creates the Waqf either way) — the self-service flow shouldn't be
// unilaterally blocked by this code on a business/legal call it isn't
// this system's place to make unprompted; it surfaces as a flag
// (WaqfsService.jurisdictionLicenseStatus, shown in the Ops Console) for
// Birr staff to act on.
model TrusteeLicense {
  id                String               @id @default(uuid())
  jurisdiction      String
  status            TrusteeLicenseStatus @default(pending)
  licensingAuthority String
  licenseNumber     String?
  issuedAt          DateTime?
  expiresAt         DateTime?
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("trustee_licenses")
}

// The "which compliance policy set applies" registry CLAUDE.md's
// jurisdiction-driven-compliance instruction calls for
// ("waqfs.jurisdiction... is what should drive which compliance policy
// set applies — don't hardcode one jurisdiction's rules") — deliberately
// a structural pointer (a named framework + where to find its actual
// text), not the regulatory content itself. This system has no real
// AAOIFI/IFSB/national-regulator feed anywhere, and inventing rule text
// would be actively harmful for a fiduciary compliance report to cite as
// real — same reasoning as Rasid's read_regulatory_sources stub (see
// services/agents/src/agents/rasid.ts). Birr's own compliance/legal
// staff populate this through the Ops Console; it starts empty.
model CompliancePolicySet {
  id            String   @id @default(uuid())
  jurisdiction  String   @unique
  frameworkName String
  referenceUrl  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("compliance_policy_sets")
}
