# Prisma CLI (migrate/seed/generate) loads its own .env from this
# package's directory, not the repo root — see the root .env.example's
# own comment on why these two are deliberately different connections.
#
# This one needs real DDL privileges (CREATE TABLE, ALTER TABLE, CREATE
# POLICY, CREATE ROLE) to actually run migrations — the schema-owner
# role ("birr" in local dev; see docker-compose.yml), not the app's own
# restricted runtime role. Never point the running app (apps/backend,
# services/agents) at this connection string — see the root
# .env.example's DATABASE_URL for that one instead.
DATABASE_URL="postgresql://birr:password@localhost:5432/birr?schema=public"
