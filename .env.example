# Shared
DATABASE_URL="postgresql://user:password@localhost:5432/birr?schema=public"
ANTHROPIC_API_KEY=""

# Auth (WorkOS or Auth0 — see CLAUDE.md, re-evaluate at pilot connection count)
AUTH_PROVIDER="auth0"
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""
AUTH_DOMAIN=""

# apps/backend
BACKEND_PORT=4000
# Backend's own publicly-reachable base URL — used to build the
# verify-email link a human clicks from their inbox.
BACKEND_URL="http://localhost:4000"

# Founder Portal session signing — generate your own real value (e.g.
# `openssl rand -hex 48`), never commit a real one. See
# apps/backend/src/common/auth/session.ts.
JWT_SECRET=""

# Encrypts provider credentials stored via the Ops Console's Platform
# Settings page. Must be exactly 32 bytes (64 hex chars) for AES-256-GCM
# — generate with `openssl rand -hex 32`, never commit a real one. See
# apps/backend/src/common/settings/encryption.service.ts.
SETTINGS_ENCRYPTION_KEY=""

# Payments — sandbox/test-mode credentials only until Birr is ready to
# go live (a separate business decision, not enforced by this code).
# Stripe = international cards, Paystack = Nigeria, the last pair =
# a third-party crypto payment gateway (Coinbase Commerce or
# equivalent) for USDC/USDT — see apps/backend/src/modules/contributions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""
# Where a provider redirects the donor back to after checkout — backend-side
# config, not client-exposed, so deliberately no NEXT_PUBLIC_ prefix.
FOUNDER_PORTAL_URL="http://localhost:3000"

# Resend — sandbox/test-mode key only until Birr is ready to go live.
# Powers two things, both behind the same SettingsService lookup
# (provider "resend"): sign-up email verification
# (apps/backend/src/modules/founders/email) and staff/founder invitation
# emails (apps/backend/src/modules/invitations/email). A sandbox key
# typically only delivers to its own account owner's address — invite/
# invitation flows fall back to a copyable link when a send fails, so
# this being sandboxed doesn't block local development.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="Birr <onboarding@resend.dev>"

# Sign-up WhatsApp verification (Twilio WhatsApp Business API) —
# sandbox/test-mode credentials only until Birr is ready to go live.
# See apps/backend/src/modules/founders/whatsapp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Bare E.164 number, no "whatsapp:" prefix — TwilioWhatsAppAdapter adds
# that itself at the API call site (see common/whatsapp/twilio-whatsapp.adapter.ts).
# A pre-prefixed value here double-prefixes and Twilio rejects the send
# outright ("not a valid phone number, shortcode, or alphanumeric sender ID").
TWILIO_WHATSAPP_FROM_NUMBER="+14155238886"

# apps/web — merged Founder Portal (app/(founder)) + Ops Console
# (app/ops) app; one deployment, one port. See the founder-portal/
# ops-console merge plan for why these two route groups share a
# deployment now.
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
WEB_PORT=3000

# services/agents — Rasid/Nazim's credentials against
# POST /ai-agents/:name/... (see apps/backend/src/common/auth/ai-agent-auth.ts).
# Dev defaults are seeded by packages/db/prisma/seed.ts when these are
# unset; generate real values (e.g. `openssl rand -hex 32`) before any
# shared/non-local use.
RASID_API_KEY=""
NAZIM_API_KEY=""
RAFIQ_API_KEY=""
# How often the scheduler in services/agents/src/index.ts runs each
# agent, in milliseconds. Per CLAUDE.md: "start simple — basic cron/queue."
AGENT_POLL_INTERVAL_MS=21600000

# Rafiq is invoked on demand (not on the scheduler above) — the backend
# calls services/agents' own small HTTP server directly when a Founder
# asks for onboarding help. AGENT_SERVICE_URL is where the backend finds
# it; AGENT_SERVICE_INTERNAL_KEY is a shared secret between the two
# processes (never sent to a browser) — generate a real value the same
# way as the agent API keys above before any shared/non-local use.
AGENT_SERVICE_URL="http://localhost:4100"
AGENT_SERVICE_INTERNAL_KEY="agent-service-dev-key-change-me"
