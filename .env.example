# Shared
DATABASE_URL="postgresql://user:password@localhost:5432/birr?schema=public"
ANTHROPIC_API_KEY=""

# Auth (WorkOS or Auth0 — see CLAUDE.md, re-evaluate at pilot connection count)
AUTH_PROVIDER="auth0"
AUTH_CLIENT_ID=""
AUTH_CLIENT_SECRET=""
AUTH_DOMAIN=""

# apps/backend
BACKEND_PORT=4000
# Backend's own publicly-reachable base URL — used to build the
# verify-email link a human clicks from their inbox.
BACKEND_URL="http://localhost:4000"

# Founder Portal session signing — generate your own real value (e.g.
# `openssl rand -hex 48`), never commit a real one. See
# apps/backend/src/common/auth/session.ts.
JWT_SECRET=""

# Encrypts provider credentials stored via the Ops Console's Platform
# Settings page. Must be exactly 32 bytes (64 hex chars) for AES-256-GCM
# — generate with `openssl rand -hex 32`, never commit a real one. See
# apps/backend/src/common/settings/encryption.service.ts.
SETTINGS_ENCRYPTION_KEY=""

# Payments — sandbox/test-mode credentials only until Birr is ready to
# go live (a separate business decision, not enforced by this code).
# Stripe = international cards, Paystack = Nigeria, the last pair =
# a third-party crypto payment gateway (Coinbase Commerce or
# equivalent) for USDC/USDT — see apps/backend/src/modules/contributions.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
COINBASE_COMMERCE_API_KEY=""
COINBASE_COMMERCE_WEBHOOK_SECRET=""
# Where a provider redirects the donor back to after checkout — backend-side
# config, not client-exposed, so deliberately no NEXT_PUBLIC_ prefix.
FOUNDER_PORTAL_URL="http://localhost:3000"

# Sign-up email verification (Resend) — sandbox/test-mode key only until
# Birr is ready to go live. See apps/backend/src/modules/founders/email.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS=""

# Sign-up WhatsApp verification (Twilio WhatsApp Business API) —
# sandbox/test-mode credentials only until Birr is ready to go live.
# See apps/backend/src/modules/founders/whatsapp.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM_NUMBER=""

# apps/founder-portal
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
FOUNDER_PORTAL_PORT=3000

# apps/ops-console
NEXT_PUBLIC_OPS_BACKEND_URL="http://localhost:4000"
OPS_CONSOLE_PORT=3001

# services/agents — Rasid/Nazim's credentials against
# POST /ai-agents/:name/... (see apps/backend/src/common/auth/ai-agent-auth.ts).
# Dev defaults are seeded by packages/db/prisma/seed.ts when these are
# unset; generate real values (e.g. `openssl rand -hex 32`) before any
# shared/non-local use.
RASID_API_KEY=""
NAZIM_API_KEY=""
# How often the scheduler in services/agents/src/index.ts runs each
# agent, in milliseconds. Per CLAUDE.md: "start simple — basic cron/queue."
AGENT_POLL_INTERVAL_MS=21600000
